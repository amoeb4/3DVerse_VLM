  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "~0.178.1",
    "@types/webxr": "^0.5.24",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
