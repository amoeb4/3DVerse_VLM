    "bridge:start": "node --loader ts-node/esm ./src/server-opcua.ts",
    "bridge:dev": "tsx ./src/server-opcua.ts",
    "grpc:client": "tsx OPC-UA/grpc_proxy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@3dverse/api": "^0.16.0",
    "@3dverse/design-tokens": "^0.1.28",
